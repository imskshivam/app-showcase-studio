# Copy to .env and fill in your values.

# OAuth Web Client ID from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Long random string used to sign session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# Frontend origin allowed to call this API (CORS + cookie target).
CLIENT_ORIGIN=http://localhost:5173

# Server port
PORT=8787

# Cookie settings (set COOKIE_SECURE=true in production behind HTTPS)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
